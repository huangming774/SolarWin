<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SolarWin.Views.ChatEncryptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SecurityCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="28,16,28,40" HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            MaxWidth="780"
            HorizontalAlignment="Center"
            Spacing="18">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Width="40"
                    Height="40"
                    Click="Back_OnClick"
                    ToolTipService.ToolTip="返回聊天">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="加密与解密" />
                    <TextBlock
                        Opacity="0.65"
                        Text="{x:Bind ViewModel.RoomTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource SecurityCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="48"
                        Height="48"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="14">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="22"
                            Glyph="&#xE72E;" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="当前会话安全状态" />
                        <TextBlock
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.E2eeStatusText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Opacity="0.65"
                            Text="状态同时校验服务端房间元数据、本机 SQLCipher 群组状态和当前 epoch。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SecurityCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="MLS 端到端加密" />
                    <TextBlock
                        Opacity="0.7"
                        Text="启用后消息内容由 RFC 9420 MLS 加密；DysonNetwork 当前协议不允许把已加密房间恢复为明文。恢复操作会重建群组并要求所有设备重新共享，不是关闭加密。"
                        TextWrapping="WrapWholeWords" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.EnableMlsCommand}"
                            Content="启用 MLS E2EE"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.RecoverMlsCommand}"
                            Content="恢复 / 重建 MLS" />
                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Content="关闭 MLS（不支持）"
                            IsEnabled="False"
                            ToolTipService.ToolTip="DysonNetwork 禁止关闭已启用的 MLS 房间" />
                    </Grid>
                </StackPanel>
            </Border>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="身份签名密钥和 SQLCipher 数据库密钥由 Windows DPAPI（当前用户）保护；消息正文只以 chat.mls.v2 密文发送到服务端。无法解密时客户端会失败关闭，不会回退为明文。"
                Severity="Success"
                Title="本机 MLS 已接入" />

            <Expander Header="高级消息工具">
                <Border
                    Padding="18"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="0,0,12,12">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Opacity="0.68"
                            Text="以下接口用于协议调试，不属于普通聊天操作。"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.SendTypingPlaceholderCommand}"
                            Content="发送 typing Placeholder" />
                        <TextBox
                            Header="重定向消息 ID"
                            MinHeight="76"
                            AcceptsReturn="True"
                            PlaceholderText="每行一个 UUID，也可以使用空格、逗号或分号分隔"
                            Text="{x:Bind ViewModel.RedirectMessageIdsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.RedirectMessagesCommand}"
                            Content="执行消息重定向" />
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
