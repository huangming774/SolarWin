<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="SolarWin.Views.WeatherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SolarWin.Models" xmlns:vm="using:SolarWin.ViewModels">
    <Page.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>
    <Grid Padding="24,20,24,0" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="8" MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="CitySearchBox" MaxWidth="420" HorizontalAlignment="Stretch"
                PlaceholderText="搜索城市" QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ItemsSource="{x:Bind ViewModel.CitySuggestions}" QuerySubmitted="CitySearchBox_OnQuerySubmitted"
                SuggestionChosen="CitySearchBox_OnSuggestionChosen" TextChanged="CitySearchBox_OnTextChanged">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="models:GeoResult"><TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
            <Button Grid.Column="1" Width="36" Height="36" Command="{x:Bind ViewModel.LoadCommand}"
                ToolTipService.ToolTip="按 IP 定位" AutomationProperties.Name="按 IP 定位"><FontIcon Glyph="&#xE707;" FontSize="16" /></Button>
            <Button Grid.Column="2" Width="36" Height="36" Command="{x:Bind ViewModel.RefreshCommand}"
                ToolTipService.ToolTip="刷新天气" AutomationProperties.Name="刷新天气"><FontIcon Glyph="&#xE72C;" FontSize="16" /></Button>
        </Grid>
        <StackPanel Grid.Row="1" MaxWidth="1120" Spacing="8">
            <ProgressBar Height="2" IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Warning" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
                <InfoBar.ActionButton><Button Content="重试" Command="{x:Bind ViewModel.RefreshCommand}" /></InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1120" Padding="0,8,0,28" Spacing="24">
                <Grid ColumnSpacing="20" Padding="4,8,4,20" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.LocationTitle, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.LocationSubtitle, Mode=OneWay}" Style="{StaticResource MetricLabel}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.TemperatureText, Mode=OneWay}" FontSize="64" FontWeight="Light" />
                        <TextBlock Text="{x:Bind ViewModel.WeatherDescription, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.HighLowText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.UpdateText, Mode=OneWay}" Style="{StaticResource MetricLabel}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WeatherEmoji, Mode=OneWay}" FontSize="64" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.FeelsLikeText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HumidityText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.WindText, Mode=OneWay}" TextWrapping="Wrap" />
                </Grid>
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
                    <TextBlock Text="逐小时预报" Style="{StaticResource SectionTitle}" />
                    <ListView Height="142" SelectionMode="None" ItemsSource="{x:Bind ViewModel.HourlyForecast}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,8,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HourlyForecastItem">
                                <Border Width="76" Height="124" CornerRadius="6" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind TimeLabel}" FontSize="12" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Emoji}" FontSize="24" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind TemperatureText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind PrecipitationChanceText}" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" FontSize="12" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <Grid x:Name="ForecastLayout" ColumnSpacing="28" RowSpacing="24" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition x:Name="DetailsColumn" Width="2*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="12">
                        <TextBlock Text="未来 10 天" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DailyForecast}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DailyForecastItem">
                                    <Grid MinHeight="54" ColumnSpacing="8" Padding="0,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="42" /><ColumnDefinition Width="42" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DateLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource MetricLabel}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Emoji}" FontSize="22" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind PrecipitationChanceText}" FontSize="12" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind HighText}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind LowText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel x:Name="DetailsPanel" Grid.Column="1" Spacing="20">
                        <TextBlock Text="今日环境" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnSpacing="20" RowSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="空气质量 · US AQI" Style="{StaticResource MetricLabel}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.AirQualityValue, Mode=OneWay}" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="{x:Bind ViewModel.AirQualityLevel, Mode=OneWay}" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.AirQualityDetail, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="降水" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{x:Bind ViewModel.PrecipitationValue, Mode=OneWay}" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="{x:Bind ViewModel.PrecipitationLevel, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.PrecipitationDetail, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="6">
                                <TextBlock Text="紫外线" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{x:Bind ViewModel.UvIndexValue, Mode=OneWay}" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="{x:Bind ViewModel.UvIndexLevel, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.UvIndexDetail, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                <TextBlock Text="日出 / 日落" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{x:Bind ViewModel.SunriseText, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.SunsetText, Mode=OneWay}" FontSize="24" />
                                <TextBlock Text="{x:Bind ViewModel.SunDetail, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Open-Meteo · IP 定位：ipwho.is" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
