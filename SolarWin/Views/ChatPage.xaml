<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SolarWin.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SolarWin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SolarWin.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ChatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Page.Resources>

    <Grid Padding="20,16,20,14" ColumnSpacing="16" RowSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="聊天" />
                    <Border
                        Padding="9,3"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <TextBlock
                            FontSize="12"
                            Text="{x:Bind ViewModel.WsStatusText, Mode=OneWay}" />
                    </Border>
                </StackPanel>
                <TextBlock
                    Opacity="0.65"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <ProgressRing
                    Width="22"
                    Height="22"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.ForceRefreshCommand}"
                    Style="{StaticResource HeaderIconButtonStyle}"
                    ToolTipService.ToolTip="刷新会话">
                    <FontIcon Glyph="&#xE72C;" />
                </Button>
                <Button Style="{StaticResource HeaderIconButtonStyle}" ToolTipService.ToolTip="更多同步操作">
                    <FontIcon Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.MarkAllReadCommand}" Text="全部标为已读" />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ReconnectWsCommand}" Text="重新连接实时消息" />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.RunGlobalMessageSyncCommand}" Text="执行全局消息同步" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Content="新建会话" Style="{StaticResource AccentButtonStyle}">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="360" Spacing="12">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="新建会话" />
                                <TextBlock Opacity="0.65" Text="创建群聊" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        PlaceholderText="群聊名称"
                                        Text="{x:Bind ViewModel.NewGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.CreateGroupRoomCommand}"
                                        Content="创建" />
                                </Grid>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock Opacity="0.65" Text="高级入口" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        PlaceholderText="Realm slug"
                                        Text="{x:Bind ViewModel.RealmSlugText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.LoadRealmChatsCommand}" Content="加载" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        PlaceholderText="对方账户 UUID"
                                        Text="{x:Bind ViewModel.DirectUserIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.StartDirectChatCommand}" Content="私聊" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Group rail -->
        <Border Grid.Row="1" Padding="14" Style="{StaticResource ChatCardStyle}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="房间分组" />
                        <TextBlock
                            Opacity="0.58"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="选择分组后可管理房间" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" Opacity="0.55" Glyph="&#xE8B7;" />
                </Grid>

                <ListView
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    ItemClick="GroupList_OnItemClick"
                    ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="CornerRadius" Value="10" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatGroupItemViewModel">
                            <Grid Padding="10,9" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="34"
                                    Height="34"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Glyph="&#xE8B7;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Opacity="0.58"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Subtitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" FontSize="12" Opacity="0.45" Glyph="&#xE76C;" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border
                    Grid.Row="2"
                    Padding="10"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="10"
                    Visibility="{x:Bind ViewModel.SelectedGroupPanelVisibility, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="编辑所选分组" />
                        <TextBox
                            Header="分组名称"
                            Text="{x:Bind ViewModel.GroupEditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.RenameSelectedGroupCommand}"
                                Content="保存名称" />
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.DeleteSelectedGroupCommand}"
                                Content="删除" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Conversation list -->
        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="10" Style="{StaticResource ChatCardStyle}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="UserSearchBox"
                        KeyDown="UserSearchBox_OnKeyDown"
                        PlaceholderText="搜索用户名或昵称，快速开始私聊"
                        Text="{x:Bind ViewModel.UserSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ProgressRing
                        Grid.Column="1"
                        Width="22"
                        Height="22"
                        IsActive="{x:Bind ViewModel.IsSearchingUsers, Mode=OneWay}" />
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                MaxHeight="220"
                Padding="8"
                Style="{StaticResource ChatCardStyle}"
                Visibility="{x:Bind ViewModel.UserSearchPanelVisibility, Mode=OneWay}">
                <ListView
                    IsItemClickEnabled="True"
                    ItemClick="UserSearch_OnItemClick"
                    ItemsSource="{x:Bind ViewModel.UserSearchResults, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.Header>
                        <TextBlock
                            Margin="6,2,6,6"
                            Opacity="0.65"
                            Text="{x:Bind ViewModel.UserSearchHintText, Mode=OneWay}" />
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:UserSearchResultItem">
                            <Grid Padding="6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="38" Height="38">
                                    <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="19">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Initials}" />
                                    </Border>
                                    <controls:FastWin2DImage
                                        Width="38"
                                        Height="38"
                                        CornerRadius="19"
                                        DecodeWidth="96"
                                        ShowPlaceholder="False"
                                        Source="{x:Bind AvatarUrl}"
                                        Stretch="UniformToFill" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Nick}" />
                                    <TextBlock Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Subtitle}" />
                                </StackPanel>
                                <Button Grid.Column="2" Click="StartDm_OnClick" Content="私聊" Tag="{x:Bind}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Expander
                Grid.Row="2"
                Header="待处理邀请"
                Visibility="{x:Bind ViewModel.PendingInvitesVisibility, Mode=OneWay}">
                <ListView
                    MaxHeight="150"
                    ItemsSource="{x:Bind ViewModel.PendingInvites, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatRoomListItem">
                            <Grid Padding="8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                <Button Grid.Column="1" Click="AcceptInvite_OnClick" Content="接受" Tag="{x:Bind}" />
                                <Button Grid.Column="2" Click="DeclineInvite_OnClick" Content="拒绝" Tag="{x:Bind}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Expander>

            <Border Grid.Row="3" Style="{StaticResource ChatCardStyle}">
                <Grid>
                    <ListView
                        x:Name="RoomList"
                        Padding="8"
                        IsItemClickEnabled="True"
                        ItemClick="RoomList_OnItemClick"
                        ItemsSource="{x:Bind ViewModel.Rooms, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.Header>
                            <Grid Margin="8,4,8,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="最近会话" />
                                <TextBlock
                                    Grid.Column="1"
                                    Opacity="0.55"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SyncStatusText, Mode=OneWay}" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="CornerRadius" Value="12" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatRoomListItem">
                                <Grid Padding="10,9" ColumnSpacing="12">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Click="MoveRoomToGroup_OnClick" Text="移入当前选中的分组" Tag="{x:Bind}" />
                                            <MenuFlyoutItem Click="RemoveRoomFromGroup_OnClick" Text="移出分组" Tag="{x:Bind}" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="50" Height="50">
                                        <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="16">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Initials}" />
                                        </Border>
                                        <controls:FastWin2DImage
                                            Width="50"
                                            Height="50"
                                            CornerRadius="16"
                                            DecodeWidth="96"
                                            EnableFadeIn="True"
                                            ShowPlaceholder="False"
                                            Source="{x:Bind AvatarUrl}"
                                            Stretch="UniformToFill" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            MaxLines="1"
                                            Opacity="0.62"
                                            Text="{x:Bind LastMessagePreview}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                                        <TextBlock
                                            Opacity="0.52"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind LastMessageTime}" />
                                        <Border
                                            MinWidth="22"
                                            Padding="7,2"
                                            HorizontalAlignment="Right"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="11"
                                            Opacity="{x:Bind UnreadOpacity}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Text="{x:Bind UnreadBadge}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
