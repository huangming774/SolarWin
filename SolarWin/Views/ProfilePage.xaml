<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SolarWin.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SolarWin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid x:Name="CenteringHost">
            <Grid
                x:Name="RootLayout"
                Width="{Binding ActualWidth, ElementName=CenteringHost}"
                MaxWidth="980"
                Padding="24"
                HorizontalAlignment="Center"
                RowSpacing="16">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Compact" />
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RightCardColumn.Width" Value="*" />
                            <Setter Target="CheckInCard.(Grid.Row)" Value="0" />
                            <Setter Target="CheckInCard.(Grid.Column)" Value="1" />
                            <Setter Target="CheckInCard.Margin" Value="0" />
                            <Setter Target="ActionFirstColumn.Width" Value="Auto" />
                            <Setter Target="ActionSecondColumn.Width" Value="Auto" />
                            <Setter Target="ActionThirdColumn.Width" Value="Auto" />
                            <Setter Target="ActionProgressColumn.Width" Value="*" />
                            <Setter Target="RefreshProfileButton.(Grid.Row)" Value="0" />
                            <Setter Target="RefreshProfileButton.(Grid.Column)" Value="2" />
                            <Setter Target="ProfileProgress.(Grid.Row)" Value="0" />
                            <Setter Target="ProfileProgress.(Grid.Column)" Value="3" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup>
                    <VisualState x:Name="ContentAreaCentered" />
                    <VisualState x:Name="FullWindowCentered">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1280" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <!-- Balance the expanded 240px NavigationView pane so the profile
                                 cards sit on the visual center of the full app window. -->
                            <Setter Target="CenteringHost.Padding" Value="0,0,240,0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="我的" />
                    <TextBlock
                        Opacity="0.68"
                        Text="管理个人资料、在线状态与每日签到"
                        TextWrapping="Wrap" />
                </StackPanel>
                <HyperlinkButton
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="OpenSettings_OnClick"
                    Content="设置" />
            </Grid>

            <!-- Profile overview -->
            <Border
                Grid.Row="1"
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid ColumnSpacing="20" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Width="88" Height="88" VerticalAlignment="Top">
                        <Border
                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            CornerRadius="44">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="32"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.Initials, Mode=OneWay}" />
                        </Border>
                        <controls:FastWin2DImage
                            Width="88"
                            Height="88"
                            CornerRadius="44"
                            DecodeWidth="256"
                            EnableFadeIn="True"
                            ShowPlaceholder="False"
                            Source="{x:Bind ViewModel.AvatarUrl, Mode=OneWay}"
                            Stretch="UniformToFill" />
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Opacity="0.75" Text="{x:Bind ViewModel.Handle, Mode=OneWay}" />
                            <TextBlock Opacity="0.35" Text="·" />
                            <TextBlock
                                Opacity="0.68"
                                Text="{x:Bind ViewModel.Meta, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            MaxWidth="700"
                            Margin="0,4,0,0"
                            Opacity="0.88"
                            Text="{x:Bind ViewModel.Bio, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <Grid
                        x:Name="ProfileActions"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        ColumnSpacing="8"
                        RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ActionFirstColumn" Width="*" />
                            <ColumnDefinition x:Name="ActionSecondColumn" Width="*" />
                            <ColumnDefinition x:Name="ActionThirdColumn" Width="0" />
                            <ColumnDefinition x:Name="ActionProgressColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button
                            HorizontalAlignment="Stretch"
                            Click="EditProfile_OnClick"
                            Content="编辑资料"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Click="ChangeAvatar_OnClick"
                            Content="更换头像" />
                        <Button
                            x:Name="RefreshProfileButton"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.LoadCommand}"
                            Content="刷新" />
                        <StackPanel
                            x:Name="ProfileProgress"
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ProgressRing
                                Width="24"
                                Height="24"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <ProgressRing
                                Width="24"
                                Height="24"
                                IsActive="{x:Bind ViewModel.IsUploadingAvatar, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Status and check-in become two columns on wide windows. -->
            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="RightCardColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="StatusCard"
                    MinHeight="220"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="在线状态" />
                            <Border
                                Grid.Column="1"
                                Padding="10,4"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="10">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                            </Border>
                        </Grid>
                        <TextBlock
                            Grid.Row="1"
                            Opacity="0.72"
                            Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.SetStatusOnlineCommand}" Content="在线" />
                            <Button Command="{x:Bind ViewModel.SetStatusIdleCommand}" Content="离开" />
                            <Button Command="{x:Bind ViewModel.SetStatusDndCommand}" Content="勿扰" />
                            <ProgressRing
                                Width="24"
                                Height="24"
                                IsActive="{x:Bind ViewModel.IsSettingStatus, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="CheckInCard"
                    Grid.Row="1"
                    MinHeight="220"
                    Margin="0,16,0,0"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="每日签到" />
                        <TextBlock
                            Grid.Row="1"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.CheckInSummary, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Grid.Row="2"
                            Opacity="0.72"
                            Text="{x:Bind ViewModel.FortuneText, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                            <Button
                                Command="{x:Bind ViewModel.CheckInCommand}"
                                Content="立即签到"
                                Style="{StaticResource AccentButtonStyle}" />
                            <ProgressRing
                                Width="24"
                                Height="24"
                                IsActive="{x:Bind ViewModel.IsCheckingIn, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3" Spacing="6">
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Text="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
