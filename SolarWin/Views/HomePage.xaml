<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SolarWin.Views.HomePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SolarWin.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <LinearGradientBrush x:Key="HomeHeroBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#EAF2FF" />
                    <GradientStop Offset="0.55" Color="#F4EEFF" />
                    <GradientStop Offset="1" Color="#FFF3F8" />
                </LinearGradientBrush>
                <SolidColorBrush x:Key="HomeTintCardBrush" Color="#F7F9FF" />
                <SolidColorBrush x:Key="HomeSoftAccentBrush" Color="#E4EDFF" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <LinearGradientBrush x:Key="HomeHeroBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#252F43" />
                    <GradientStop Offset="0.55" Color="#302A43" />
                    <GradientStop Offset="1" Color="#3A2935" />
                </LinearGradientBrush>
                <SolidColorBrush x:Key="HomeTintCardBrush" Color="#1E2230" />
                <SolidColorBrush x:Key="HomeSoftAccentBrush" Color="#293751" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Default">
                <LinearGradientBrush x:Key="HomeHeroBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#252F43" />
                    <GradientStop Offset="0.55" Color="#302A43" />
                    <GradientStop Offset="1" Color="#3A2935" />
                </LinearGradientBrush>
                <SolidColorBrush x:Key="HomeTintCardBrush" Color="#1E2230" />
                <SolidColorBrush x:Key="HomeSoftAccentBrush" Color="#293751" />
            </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="HomeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style x:Key="HomeSectionCardStyle" TargetType="Border" BasedOn="{StaticResource HomeCardStyle}">
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="HomeTintCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource HomeTintCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="HomeSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="HomeSectionCaptionStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.62" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="HomeListStyle" TargetType="ListView">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style x:Key="HomePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
        <Style x:Key="HomeButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource HomeButtonStyle}" />
        <Style TargetType="ListView" BasedOn="{StaticResource HomeListStyle}" />
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <DataTemplate x:Key="SocialRowTemplate" x:DataType="vm:SocialListItemViewModel">
            <Grid Padding="8,7" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Opacity="0.75"
                        Text="{x:Bind Subtitle}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Opacity="0.55"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Meta}" />
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid
        MaxWidth="1320"
        Padding="24,18,24,16"
        HorizontalAlignment="Stretch"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Padding="18,15" Style="{StaticResource HomeCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="48"
                    Height="48"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    CornerRadius="15">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="21"
                        Glyph="&#xE80F;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                    <TextBlock
                        Opacity="0.78"
                        Text="{x:Bind ViewModel.WelcomeText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Opacity="0.55"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.OverviewMeta, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        Width="22"
                        Height="22"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <Button
                        Width="40"
                        Height="40"
                        Padding="0"
                        Command="{x:Bind ViewModel.LoadCommand}"
                        CornerRadius="10"
                        ToolTipService.ToolTip="刷新当前已访问的数据">
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                Opacity="0.7"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <!-- Sections -->
        <Pivot
            Grid.Row="2"
            SelectedIndex="{x:Bind ViewModel.SelectedSectionIndex, Mode=TwoWay}"
            SelectionChanged="Sections_OnSelectionChanged">
            <!-- 概览 -->
            <PivotItem Header="概览">
                <ScrollViewer Padding="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel
                        MaxWidth="1080"
                        HorizontalAlignment="Center"
                        Spacing="16">
                        <Border
                            Padding="24"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource HomeCardStyle}">
                            <Grid ColumnSpacing="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border
                                            Width="38"
                                            Height="38"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                            CornerRadius="12">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="17"
                                                Glyph="&#xE735;" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="成长概览" />
                                            <TextBlock
                                                Opacity="0.55"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="查看近期等级和经验进度" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="22"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.LevelText, Mode=OneWay}" />
                                    <ProgressBar
                                        Height="8"
                                        Maximum="1"
                                        Value="{x:Bind ViewModel.LevelProgress, Mode=OneWay}" />
                                    <TextBlock
                                        Opacity="0.68"
                                        Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                                </StackPanel>
                                <Grid Grid.Column="1" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Padding="14"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="12">
                                        <StackPanel VerticalAlignment="Center" Spacing="5">
                                            <FontIcon HorizontalAlignment="Left" FontSize="18" Glyph="&#xE8C7;" />
                                            <TextBlock Opacity="0.58" Text="积分" />
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind ViewModel.CreditsText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Padding="14"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="12">
                                        <StackPanel VerticalAlignment="Center" Spacing="5">
                                            <FontIcon HorizontalAlignment="Left" FontSize="18" Glyph="&#xE734;" />
                                            <TextBlock Opacity="0.58" Text="成就" />
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind ViewModel.AchievementStatsText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="今日工具" />
                            <Rectangle
                                Grid.Column="1"
                                Height="1"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        </Grid>
                        <Grid
                            HorizontalAlignment="Stretch"
                            ColumnSpacing="14"
                            RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 运势 -->
                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                MinHeight="176"
                                Padding="18"
                                Style="{StaticResource HomeCardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="34" Height="34" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="10">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Glyph="&#xE790;" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="今日运势" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="15"
                                        Text="{x:Bind ViewModel.FortuneText, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        Opacity="0.6"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.FortuneSourceText, Mode=OneWay}" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        Command="{x:Bind ViewModel.DrawFortuneCommand}"
                                        Content="抽签"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </Border>

                            <!-- IP -->
                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                MinHeight="176"
                                Padding="18"
                                Style="{StaticResource HomeCardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="34" Height="34" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="10">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Glyph="&#xE968;" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="IP 检测" />
                                    </StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.IpCheckText, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        Opacity="0.75"
                                        Text="{x:Bind ViewModel.IpGeoText, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        Command="{x:Bind ViewModel.RefreshIpCheckCommand}"
                                        Content="刷新 IP" />
                                </StackPanel>
                            </Border>

                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 找人 -->
            <PivotItem Header="找人">
                <ScrollViewer Padding="0,8,0,0">
                    <StackPanel MaxWidth="1120" HorizontalAlignment="Center" Spacing="16">
                        <Border Padding="22" Background="{ThemeResource HomeHeroBrush}" CornerRadius="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" Background="{ThemeResource HomeSoftAccentBrush}" CornerRadius="15">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Glyph="&#xE721;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Style="{StaticResource HomeSectionTitleStyle}" Text="发现新朋友" />
                                    <TextBlock Style="{StaticResource HomeSectionCaptionStyle}" Text="搜索昵称或用户名，快速查看公开资料与建立联系。" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource HomeSectionCardStyle}">
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="搜索用户名 / 昵称" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.SearchPeopleCommand}" Content="搜索" Style="{StaticResource HomePrimaryButtonStyle}" />
                                <TextBox Grid.Column="2" PlaceholderText="精确用户名" Text="{x:Bind ViewModel.ProfileLookupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="3" Command="{x:Bind ViewModel.LoadPersonProfileCommand}" Content="预览" />
                                <Button Grid.Column="4" Command="{x:Bind ViewModel.OpenViewedProfilePageCommand}" Content="打开资料页" />
                            </Grid>
                        </Border>

                        <ListView
                            MaxHeight="160"
                            ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ItemClick="SearchResult_OnItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:UserSearchResultItem">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="4">
                                        <Grid Width="36" Height="36">
                                            <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="18">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Initials}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Nick}" />
                                            <TextBlock Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Subtitle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.ViewedProfileTitle, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.ViewedProfileBody, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Opacity="0.75" Text="{x:Bind ViewModel.ViewedProfileMeta, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Opacity="0.85" Text="{x:Bind ViewModel.RelationshipActionHint, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Command="{x:Bind ViewModel.OpenViewedProfilePageCommand}"
                                        Content="资料页" />
                                    <Button
                                        Command="{x:Bind ViewModel.StartDirectChatWithViewedCommand}"
                                        Content="私聊"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button Command="{x:Bind ViewModel.SendFriendRequestCommand}" Content="加好友" />
                                    <Button Command="{x:Bind ViewModel.BlockViewedCommand}" Content="拉黑" />
                                    <Button Command="{x:Bind ViewModel.UnblockViewedCommand}" Content="取消拉黑" />
                                    <Button Command="{x:Bind ViewModel.MuteViewedCommand}" Content="静音" />
                                    <Button Command="{x:Bind ViewModel.UnmuteViewedCommand}" Content="取消静音" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="徽章" />
                        <ListView
                            MaxHeight="140"
                            ItemTemplate="{StaticResource SocialRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.ViewedBadges, Mode=OneWay}"
                            SelectionMode="None" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="主页组件 Board" />
                        <ListView
                            MaxHeight="140"
                            ItemTemplate="{StaticResource SocialRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.ViewedBoard, Mode=OneWay}"
                            SelectionMode="None" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="公开连接" />
                        <ListView
                            MaxHeight="120"
                            ItemTemplate="{StaticResource SocialRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.ViewedConnections, Mode=OneWay}"
                            SelectionMode="None" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 好友 -->
            <PivotItem Header="好友">
                <ScrollViewer Padding="0,8,0,0">
                    <StackPanel MaxWidth="1120" HorizontalAlignment="Center" Spacing="16">
                        <Border Padding="22" Background="{ThemeResource HomeHeroBrush}" CornerRadius="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" Background="{ThemeResource HomeSoftAccentBrush}" CornerRadius="15">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Glyph="&#xE716;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Style="{StaticResource HomeSectionTitleStyle}" Text="好友与连接" />
                                    <TextBlock Style="{StaticResource HomeSectionCaptionStyle}" Text="管理好友请求、密友关系与日常联系。" />
                                </StackPanel>
                                <Border Grid.Column="2" Padding="14,8" VerticalAlignment="Center" Background="{ThemeResource HomeSoftAccentBrush}" CornerRadius="12">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.FriendsSummary, Mode=OneWay}" />
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="好友请求" />
                        <ListView
                            MaxHeight="200"
                            ItemsSource="{x:Bind ViewModel.FriendRequests, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock Opacity="0.7" Text="{x:Bind Subtitle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button
                                                Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="AcceptFriendCommand"
                                                Content="接受" />
                                            <Button
                                                Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="DeclineFriendCommand"
                                                Content="拒绝" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="好友" />
                        <ListView
                            MaxHeight="280"
                            ItemsSource="{x:Bind ViewModel.Friends, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock Opacity="0.7" Text="{x:Bind Subtitle}" />
                                            <TextBlock Opacity="0.5" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Meta}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button
                                                Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="StartDirectChatWithFriendCommand"
                                                Content="私聊"
                                                Style="{StaticResource AccentButtonStyle}" />
                                            <Button
                                                Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="OpenFriendProfileCommand"
                                                Content="资料" />
                                            <Button
                                                Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="SetCloseFriendCommand"
                                                Content="密友" />
                                            <Button
                                                Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="RemoveFriendCommand"
                                                Content="移除" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="密友" />
                        <ListView
                            MaxHeight="160"
                            ItemTemplate="{StaticResource SocialRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.CloseFriends, Mode=OneWay}"
                            SelectionMode="None" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 领域 -->
            <PivotItem Header="领域">
                <ScrollViewer Padding="0,8,0,0">
                    <StackPanel MaxWidth="1120" HorizontalAlignment="Center" Spacing="16">
                        <Border Padding="22" Background="{ThemeResource HomeHeroBrush}" CornerRadius="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" Background="{ThemeResource HomeSoftAccentBrush}" CornerRadius="15">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Glyph="&#xE909;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Style="{StaticResource HomeSectionTitleStyle}" Text="你的领域空间" />
                                    <TextBlock Style="{StaticResource HomeSectionCaptionStyle}" Text="创建兴趣空间，邀请成员，并探索公开社区。" />
                                </StackPanel>
                                <Border Grid.Column="2" Padding="14,8" VerticalAlignment="Center" Background="{ThemeResource HomeSoftAccentBrush}" CornerRadius="12">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.RealmQuotaText, Mode=OneWay}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource HomeSectionCardStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="唯一标识 slug" Text="{x:Bind ViewModel.NewRealmSlug, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1" PlaceholderText="领域名称" Text="{x:Bind ViewModel.NewRealmName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Command="{x:Bind ViewModel.CreateRealmCommand}" Content="创建领域" Style="{StaticResource HomePrimaryButtonStyle}" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="我的领域" />
                        <ListView
                            MaxHeight="180"
                            ItemsSource="{x:Bind ViewModel.MyRealms, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock Opacity="0.7" Text="{x:Bind Subtitle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button
                                                Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="OpenRealmDetailCommand"
                                                Content="详情"
                                                Style="{StaticResource AccentButtonStyle}" />
                                            <Button
                                                Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="LeaveRealmCommand"
                                                Content="退出" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="公开领域" />
                        <ListView
                            MaxHeight="180"
                            ItemsSource="{x:Bind ViewModel.PublicRealms, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock Opacity="0.7" Text="{x:Bind Subtitle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button
                                                Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="OpenRealmDetailCommand"
                                                Content="详情"
                                                Style="{StaticResource AccentButtonStyle}" />
                                            <Button
                                                Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="JoinRealmCommand"
                                                Content="加入" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="邀请" />
                        <ListView
                            MaxHeight="140"
                            ItemsSource="{x:Bind ViewModel.RealmInvites, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button
                                                Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="AcceptRealmInviteCommand"
                                                Content="接受" />
                                            <Button
                                                Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="DeclineRealmInviteCommand"
                                                Content="拒绝" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedRealmSlug, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                Width="280"
                                PlaceholderText="邀请用户 GUID"
                                Text="{x:Bind ViewModel.InviteUserId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{x:Bind ViewModel.InviteToSelectedRealmCommand}" Content="邀请加入" />
                        </StackPanel>
                        <TextBlock Opacity="0.7" Text="成员" />
                        <ListView
                            MaxHeight="160"
                            ItemTemplate="{StaticResource SocialRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.SelectedRealmMembers, Mode=OneWay}"
                            SelectionMode="None" />
                        <TextBlock Opacity="0.7" Text="角色权限" />
                        <ListView
                            MaxHeight="140"
                            ItemTemplate="{StaticResource SocialRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.SelectedRealmPermissions, Mode=OneWay}"
                            SelectionMode="None" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 成长 -->
            <PivotItem Header="成长">
                <ScrollViewer Padding="0,8,0,0">
                    <StackPanel MaxWidth="1120" HorizontalAlignment="Center" Spacing="16">
                        <Border Padding="22" Background="{ThemeResource HomeHeroBrush}" CornerRadius="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" Background="{ThemeResource HomeSoftAccentBrush}" CornerRadius="15">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Glyph="&#xE735;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Style="{StaticResource HomeSectionTitleStyle}" Text="记录每一步成长" />
                                    <TextBlock Style="{StaticResource HomeSectionCaptionStyle}" Text="在这里回顾徽章、经验、积分、成就和任务进度。" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="徽章墙" />
                        <ListView
                            MaxHeight="160"
                            ItemsSource="{x:Bind ViewModel.Badges, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock Opacity="0.7" Text="{x:Bind Subtitle}" />
                                            <TextBlock Opacity="0.5" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Meta}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="ActivateBadgeCommand"
                                            Content="设为展示" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Board" />
                        <ListView MaxHeight="120" ItemTemplate="{StaticResource SocialRowTemplate}" ItemsSource="{x:Bind ViewModel.BoardItems, Mode=OneWay}" SelectionMode="None" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="经验流水" />
                        <ListView MaxHeight="160" ItemTemplate="{StaticResource SocialRowTemplate}" ItemsSource="{x:Bind ViewModel.LevelingRecords, Mode=OneWay}" SelectionMode="None" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="积分流水" />
                        <ListView MaxHeight="160" ItemTemplate="{StaticResource SocialRowTemplate}" ItemsSource="{x:Bind ViewModel.CreditRecords, Mode=OneWay}" SelectionMode="None" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="成就" />
                        <ListView MaxHeight="180" ItemTemplate="{StaticResource SocialRowTemplate}" ItemsSource="{x:Bind ViewModel.Achievements, Mode=OneWay}" SelectionMode="None" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="任务" />
                        <ListView MaxHeight="160" ItemTemplate="{StaticResource SocialRowTemplate}" ItemsSource="{x:Bind ViewModel.Quests, Mode=OneWay}" SelectionMode="None" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="奖励发放" />
                        <ListView MaxHeight="120" ItemTemplate="{StaticResource SocialRowTemplate}" ItemsSource="{x:Bind ViewModel.Grants, Mode=OneWay}" SelectionMode="None" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="动作日志" />
                        <ListView MaxHeight="140" ItemTemplate="{StaticResource SocialRowTemplate}" ItemsSource="{x:Bind ViewModel.ActionLogs, Mode=OneWay}" SelectionMode="None" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 日历 -->
            <PivotItem Header="日历">
                <ScrollViewer Padding="0,8,0,0">
                    <StackPanel MaxWidth="1120" HorizontalAlignment="Center" Spacing="16">
                        <Border Padding="22" Background="{ThemeResource HomeHeroBrush}" CornerRadius="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" Background="{ThemeResource HomeSoftAccentBrush}" CornerRadius="15">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Glyph="&#xE787;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Style="{StaticResource HomeSectionTitleStyle}" Text="今天，由你安排" />
                                    <TextBlock Style="{StaticResource HomeSectionCaptionStyle}" Text="集中管理日程、倒计时与值得纪念的日子。" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{x:Bind ViewModel.CalendarDayText, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource HomeSectionCardStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="添加一条新日程…" Text="{x:Bind ViewModel.NewEventTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.CreateEventCommand}" Content="添加日程" Style="{StaticResource HomePrimaryButtonStyle}" />
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="日程" />
                        <ListView
                            MaxHeight="220"
                            ItemsSource="{x:Bind ViewModel.CalendarEvents, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock Opacity="0.7" Text="{x:Bind Subtitle}" />
                                            <TextBlock Opacity="0.5" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Meta}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="DeleteEventCommand"
                                            Content="删除" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="倒计时" />
                        <ListView MaxHeight="160" ItemTemplate="{StaticResource SocialRowTemplate}" ItemsSource="{x:Bind ViewModel.CountdownItems, Mode=OneWay}" SelectionMode="None" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="纪念日" />
                        <ListView MaxHeight="120" ItemTemplate="{StaticResource SocialRowTemplate}" ItemsSource="{x:Bind ViewModel.NotableDays, Mode=OneWay}" SelectionMode="None" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 工单 -->
            <PivotItem Header="工单">
                <ScrollViewer Padding="0,8,0,0">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Center" Spacing="16">
                        <Border Padding="22" Background="{ThemeResource HomeHeroBrush}" CornerRadius="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" Background="{ThemeResource HomeSoftAccentBrush}" CornerRadius="15">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Glyph="&#xE90F;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Style="{StaticResource HomeSectionTitleStyle}" Text="需要帮助？" />
                                    <TextBlock Style="{StaticResource HomeSectionCaptionStyle}" Text="清晰描述你的问题，我们会通过工单持续跟进。" />
                                </StackPanel>
                                <Border Grid.Column="2" Padding="14,8" VerticalAlignment="Center" Background="{ThemeResource HomeSoftAccentBrush}" CornerRadius="12">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.TicketCountText, Mode=OneWay}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource HomeSectionCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource HomeSectionTitleStyle}" Text="创建新工单" />
                                <TextBox PlaceholderText="一句话概括问题" Text="{x:Bind ViewModel.NewTicketTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox MinHeight="110" AcceptsReturn="True" PlaceholderText="补充问题详情、复现步骤或期待的结果…" Text="{x:Bind ViewModel.NewTicketContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.CreateTicketCommand}" Content="提交工单" Style="{StaticResource HomePrimaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                        <ListView
                            MaxHeight="360"
                            ItemTemplate="{StaticResource SocialRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.Tickets, Mode=OneWay}"
                            SelectionMode="None" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 附近 -->
            <PivotItem Header="附近">
                <ScrollViewer Padding="0,8,0,0">
                    <StackPanel MaxWidth="1120" HorizontalAlignment="Center" Spacing="16">
                        <Border Padding="22" Background="{ThemeResource HomeHeroBrush}" CornerRadius="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" Background="{ThemeResource HomeSoftAccentBrush}" CornerRadius="15">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Glyph="&#xE81D;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Style="{StaticResource HomeSectionTitleStyle}" Text="探索身边的连接" />
                                    <TextBlock Style="{StaticResource HomeSectionCaptionStyle}" Text="创建位置 Pin、发起聚会，看看附近正在发生什么。" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource HomeSectionCardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon FontSize="17" Glyph="&#xE707;" />
                                        <TextBlock Style="{StaticResource HomeSectionTitleStyle}" Text="放置 Pin" />
                                    </StackPanel>
                                    <TextBox PlaceholderText="给这个地点起个名字" Text="{x:Bind ViewModel.NewPinName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.CreatePinCommand}" Content="创建 Pin" Style="{StaticResource HomePrimaryButtonStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource HomeSectionCardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon FontSize="17" Glyph="&#xE716;" />
                                        <TextBlock Style="{StaticResource HomeSectionTitleStyle}" Text="发起聚会" />
                                    </StackPanel>
                                    <TextBox PlaceholderText="简单说说聚会内容" Text="{x:Bind ViewModel.NewMeetNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.CreateMeetCommand}" Content="创建聚会" Style="{StaticResource HomePrimaryButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="我的 Pin" />
                        <ListView
                            MaxHeight="140"
                            ItemsSource="{x:Bind ViewModel.MyPins, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock Opacity="0.7" Text="{x:Bind Subtitle}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="DeletePinCommand"
                                            Content="删除" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="附近 Pin" />
                        <ListView MaxHeight="120" ItemTemplate="{StaticResource SocialRowTemplate}" ItemsSource="{x:Bind ViewModel.NearbyPins, Mode=OneWay}" SelectionMode="None" />

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="我的聚会" />
                        <ListView
                            MaxHeight="140"
                            ItemsSource="{x:Bind ViewModel.MyMeets, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock Opacity="0.7" Text="{x:Bind Meta}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="CompleteMeetCommand"
                                            Content="结束" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="附近聚会" />
                        <ListView
                            MaxHeight="140"
                            ItemsSource="{x:Bind ViewModel.NearbyMeets, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock Opacity="0.7" Text="{x:Bind Subtitle}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Click="SocialAction_OnClick"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="JoinMeetCommand"
                                            Content="加入" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="NFC" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                Width="220"
                                PlaceholderText="UID / 查询"
                                Text="{x:Bind ViewModel.NfcLookupQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{x:Bind ViewModel.LookupNfcCommand}" Content="查询" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.NfcLookupResult, Mode=OneWay}" TextWrapping="Wrap" />
                        <ListView MaxHeight="120" ItemTemplate="{StaticResource SocialRowTemplate}" ItemsSource="{x:Bind ViewModel.NfcTags, Mode=OneWay}" SelectionMode="None" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>
