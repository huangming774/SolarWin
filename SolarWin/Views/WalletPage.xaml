<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SolarWin.Views.WalletPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SolarWin.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="WalletTransactionItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Page.Resources>

    <Grid Padding="28,22,28,24">
        <Grid
            MaxWidth="1120"
            HorizontalAlignment="Stretch"
            RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page heading -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="钱包" />
                    <TextBlock
                        Opacity="0.62"
                        Text="查看资产余额与最近资金动态" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <ProgressRing
                        Width="22"
                        Height="22"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind ViewModel.LoadCommand}"
                        ToolTipService.ToolTip="刷新钱包">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Balance hero + asset summary -->
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border
                    MinHeight="190"
                    Padding="26,22"
                    CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#FFB9364B" />
                            <GradientStop Offset="0.16" Color="#FFC05D32" />
                            <GradientStop Offset="0.32" Color="#FFA27C22" />
                            <GradientStop Offset="0.49" Color="#FF258453" />
                            <GradientStop Offset="0.66" Color="#FF167D82" />
                            <GradientStop Offset="0.83" Color="#FF2F62A5" />
                            <GradientStop Offset="1" Color="#FFA04479" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    Foreground="White"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.TitleText, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="#D9FFFFFF"
                                    FontSize="12"
                                    Text="主钱包" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="42"
                                Height="42"
                                Background="#26FFFFFF"
                                CornerRadius="12">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    FontSize="20"
                                    Glyph="&#xE8C7;" />
                            </Border>
                        </Grid>

                        <StackPanel
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Spacing="3">
                            <TextBlock
                                Foreground="#D9FFFFFF"
                                FontSize="13"
                                Text="可用余额" />
                            <TextBlock
                                Foreground="White"
                                FontSize="36"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.BalanceText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border
                            Grid.Row="2"
                            Padding="9,5"
                            HorizontalAlignment="Left"
                            Background="#20FFFFFF"
                            CornerRadius="8"
                            Visibility="{x:Bind ViewModel.WalletMetaVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon
                                    Foreground="#D9FFFFFF"
                                    FontSize="11"
                                    Glyph="&#xE943;" />
                                <TextBlock
                                    Foreground="#E6FFFFFF"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Text="{x:Bind ViewModel.WalletMetaText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    MinHeight="190"
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="资产概览" />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.58"
                                    Text="各币种可用余额" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                CornerRadius="10">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Glyph="&#xE9D2;" />
                            </Border>
                        </Grid>
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,18,0,14"
                            VerticalAlignment="Center"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.PocketSummaryText, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <Border
                            Grid.Row="2"
                            Padding="10,7"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE72E;" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.68"
                                    Text="余额数据由钱包服务实时提供"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <InfoBar
                Grid.Row="2"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Title="钱包加载失败" />

            <!-- Transaction history -->
            <Border
                Grid.Row="3"
                MinHeight="240"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <Grid Padding="20,18,20,12" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="最近交易" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.58"
                                Text="按时间从新到旧排列" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0.62"
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListView
                            ItemsSource="{x:Bind ViewModel.Transactions, Mode=OneWay}"
                            ItemContainerStyle="{StaticResource WalletTransactionItemStyle}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:WalletTransactionItemViewModel">
                                    <Border
                                        Padding="12,10"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="38"
                                                Height="38"
                                                Background="{x:Bind IconBackground}"
                                                CornerRadius="11">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{x:Bind IconForeground}"
                                                    FontSize="16"
                                                    Glyph="{x:Bind IconGlyph}" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Opacity="0.58"
                                                        Text="{x:Bind DirectionText}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Opacity="0.35"
                                                        Text="·" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Opacity="0.58"
                                                        Text="{x:Bind StatusText}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                MinWidth="116"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    Foreground="{x:Bind AmountForeground}"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind AmountText}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontSize="11"
                                                    Opacity="0.55"
                                                    Text="{x:Bind TimeText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.Footer>
                                <StackPanel
                                    Padding="8,10,8,4"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.LoadMoreVisibility, Mode=OneWay}">
                                    <Button
                                        Command="{x:Bind ViewModel.LoadMoreCommand}"
                                        Content="加载更多记录" />
                                    <ProgressRing
                                        Width="19"
                                        Height="19"
                                        IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />
                                </StackPanel>
                            </ListView.Footer>
                        </ListView>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                            <Border
                                Width="52"
                                Height="52"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="16">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    Glyph="&#xE9D9;"
                                    Opacity="0.5" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="暂无交易记录" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Opacity="0.55"
                                Text="新的资金变化会显示在这里" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
