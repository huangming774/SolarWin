<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SolarWin.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SolarWin.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="22" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SettingsTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.68" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="SettingsIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout" />
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightColumn.Width" Value="0" />
                        <Setter Target="SecondaryPanel.(Grid.Column)" Value="0" />
                        <Setter Target="SecondaryPanel.(Grid.Row)" Value="1" />
                        <Setter Target="SecondaryPanel.Margin" Value="0,18,0,0" />
                        <Setter Target="SettingsContent.Padding" Value="20,12,20,36" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ExpandedLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1250" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            x:Name="SettingsContent"
            HorizontalScrollBarVisibility="Disabled"
            Padding="32,16,32,40"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1120"
                HorizontalAlignment="Center"
                Spacing="22">

                <!-- Page header -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Width="40"
                        Height="40"
                        Click="Back_OnClick"
                        ToolTipService.ToolTip="返回">
                        <FontIcon FontSize="16" Glyph="&#xE72B;" />
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />
                        <TextBlock
                            Opacity="0.65"
                            Text="管理外观、桌面行为、账户与本地数据" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="BodyGrid" ColumnSpacing="20" RowSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="*" />
                        <ColumnDefinition x:Name="RightColumn" Width="380" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Appearance and desktop -->
                    <StackPanel x:Name="PrimaryPanel" Spacing="18">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="18">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingsIconStyle}" />
                                    <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="外观" />
                                </StackPanel>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="应用主题" />
                                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}">
                                            <Run Text="当前：" />
                                            <Run Text="{x:Bind ViewModel.ThemeLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <ComboBox
                                            MinWidth="140"
                                            SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="跟随系统" />
                                            <ComboBoxItem Content="浅色" />
                                            <ComboBoxItem Content="深色" />
                                        </ComboBox>
                                        <Button
                                            Command="{x:Bind ViewModel.ApplyThemeCommand}"
                                            Content="应用"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xEB9F;" Style="{StaticResource SettingsIconStyle}" />
                                    <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="背景壁纸" />
                                </StackPanel>
                                <TextBlock
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="自定义应用背景，并调整透明度、模糊和材质效果。" />
                                <Border
                                    Height="190"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Grid>
                                        <Image
                                            Source="{x:Bind ViewModel.WallpaperPreview, Mode=OneWay}"
                                            Stretch="UniformToFill" />
                                        <Border
                                            Margin="12"
                                            Padding="10,6"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Background="#A8000000"
                                            CornerRadius="7">
                                            <TextBlock
                                                MaxWidth="430"
                                                Foreground="White"
                                                Text="{x:Bind ViewModel.WallpaperPathText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Command="{x:Bind ViewModel.PickWallpaperCommand}"
                                            Content="选择图片"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            Command="{x:Bind ViewModel.ClearWallpaperCommand}"
                                            Content="清除" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        Header="启用壁纸"
                                        IsOn="{x:Bind ViewModel.WallpaperEnabled, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        Header="透明度"
                                        Maximum="100"
                                        Minimum="10"
                                        StepFrequency="1"
                                        Value="{x:Bind ViewModel.WallpaperOpacity, Mode=TwoWay}" />
                                    <Slider
                                        Grid.Column="1"
                                        Header="模糊强度"
                                        Maximum="100"
                                        Minimum="0"
                                        StepFrequency="1"
                                        Value="{x:Bind ViewModel.WallpaperBlur, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock VerticalAlignment="Center" Opacity="0.68" Text="材质" />
                                    <ToggleButton
                                        MinWidth="96"
                                        Content="玻璃"
                                        IsChecked="{x:Bind ViewModel.IsGlassEffect, Mode=TwoWay}" />
                                    <ToggleButton
                                        MinWidth="96"
                                        Content="磨砂"
                                        IsChecked="{x:Bind ViewModel.IsFrostedEffect, Mode=TwoWay}" />
                                </StackPanel>
                                <TextBlock
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="{x:Bind ViewModel.WallpaperStatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SettingsIconStyle}" />
                                    <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="桌面、托盘与通知" />
                                </StackPanel>
                                <ToggleSwitch
                                    Header="关闭窗口时最小化到托盘"
                                    IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
                                <ToggleSwitch
                                    Header="最小化时隐藏到托盘"
                                    IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                                <ToggleSwitch
                                    Header="使用 Windows 系统通知"
                                    IsOn="{x:Bind ViewModel.UseSystemNotifications, Mode=TwoWay}" />
                                <ToggleSwitch
                                    Header="在后台收到聊天消息时通知"
                                    IsOn="{x:Bind ViewModel.ChatMessageNotifications, Mode=TwoWay}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="缩略图并发数" />
                                        <TextBlock
                                            Style="{StaticResource SettingsDescriptionStyle}"
                                            Text="控制文件缩略图同时下载和解码的数量，重启后生效。" />
                                    </StackPanel>
                                    <NumberBox
                                        Grid.Column="1"
                                        Maximum="16"
                                        Minimum="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind ViewModel.FileThumbnailMaxConcurrency, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{x:Bind ViewModel.TestSystemNotificationCommand}" Content="测试通知" />
                                    <Button Command="{x:Bind ViewModel.TestTrayCommand}" Content="测试托盘" />
                                    <Button Command="{x:Bind ViewModel.MinimizeToTrayNowCommand}" Content="最小化到托盘" />
                                </StackPanel>
                                <TextBlock
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="{x:Bind ViewModel.TrayStatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE950;" Style="{StaticResource SettingsIconStyle}" />
                                    <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="AI 软件接入（MCP）" />
                                </StackPanel>
                                <TextBlock
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="为其他 AI 客户端提供标准 MCP 接口。默认关闭，只监听本机地址，并要求访问令牌。" />
                                <ToggleSwitch
                                    Header="启用本机 MCP 服务"
                                    IsOn="{x:Bind ViewModel.McpEnabled, Mode=TwoWay}" />
                                <TextBox
                                    Header="MCP 地址"
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.McpEndpoint, Mode=OneWay}" />
                                <TextBox
                                    Header="Bearer 访问令牌"
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.McpAccessToken, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="{x:Bind ViewModel.McpStatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Account, storage and advanced -->
                    <StackPanel
                        x:Name="SecondaryPanel"
                        Grid.Column="1"
                        Spacing="18">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE77B;" Style="{StaticResource SettingsIconStyle}" />
                                    <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="账户与安全" />
                                </StackPanel>
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="Security_OnClick">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE72E;" />
                                        <TextBlock Text="设备、会话、MFA 与密钥" />
                                    </StackPanel>
                                </Button>
                                <TextBlock
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="已保存账户" />
                                <ListView
                                    IsItemClickEnabled="False"
                                    ItemsSource="{x:Bind ViewModel.SavedAccounts, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:SavedAccountProfile">
                                            <Grid Padding="0,7" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayLabel}" />
                                                    <TextBlock
                                                        Opacity="0.6"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind LastUsedAt}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                    <Button Click="SwitchAccount_OnClick" Content="切换" Tag="{x:Bind}" />
                                                    <Button Click="RemoveAccount_OnClick" Content="移除" Tag="{x:Bind}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.RefreshAccountsCommand}"
                                    Content="刷新账户列表" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE7C3;" Style="{StaticResource SettingsIconStyle}" />
                                    <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="存储与缓存" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="JSON 离线缓存" />
                                        <TextBlock Opacity="0.65" Text="{x:Bind ViewModel.CacheSizeText, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.ClearOfflineCacheCommand}"
                                        Content="清空" />
                                </Grid>
                                <Button
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.RefreshCacheStatsCommand}"
                                    Content="刷新统计" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock FontWeight="SemiBold" Text="本地聊天数据库" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="{x:Bind ViewModel.LocalChatDbPathText, Mode=OneWay}" />
                                <Button
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.ClearLocalChatDataCommand}"
                                    Content="清除本地聊天数据" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE774;" Style="{StaticResource SettingsIconStyle}" />
                                    <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="链接与诊断" />
                                </StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="solian:// 深度链接" />
                                <TextBlock
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="{x:Bind ViewModel.ProtocolStatusText, Mode=OneWay}" />
                                <Button
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.RegisterProtocolCommand}"
                                    Content="注册 solian:// 协议" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Opacity="0.58"
                                    Text="solian://user/demo&#x0a;solian://chat/{roomId}&#x0a;solian://settings"
                                    TextWrapping="Wrap" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock FontWeight="SemiBold" Text="SQLite 写入泵" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Opacity="0.78"
                                    Text="{x:Bind ViewModel.WritePumpStatsText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <Button
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.RefreshWritePumpStatsCommand}"
                                    Content="刷新写入指标" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE946;" Style="{StaticResource SettingsIconStyle}" />
                                    <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="关于" />
                                </StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Solar Network Windows 客户端" />
                                <TextBlock>
                                    <Run Text="版本 " />
                                    <Run Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Opacity="0.6" Text="api.solian.app" />
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="22"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <StackPanel Spacing="12">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="退出账户" />
                                <TextBlock
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="退出当前账户，但不会删除其他已保存账户。" />
                                <Button
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.LogoutCommand}"
                                    Content="退出登录" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock
                    Margin="4,0"
                    Opacity="0.78"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
