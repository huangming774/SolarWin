<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SolarWin.Views.ChatDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SolarWin.Controls"
    xmlns:vm="using:SolarWin.ViewModels"
    xmlns:svc="using:SolarWin.Services"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ChatHeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="ComposerIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="MessageActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.ColumnSpan="2"
            Margin="12,8,12,4"
            Padding="12,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Click="BackButton_OnClick"
                    Style="{StaticResource ChatHeaderIconButtonStyle}"
                    ToolTipService.ToolTip="返回">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>
                <Border
                    Grid.Column="1"
                    Width="42"
                    Height="42"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    CornerRadius="12">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="19"
                        Glyph="&#xE8BD;" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.RoomTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock
                            Opacity="0.66"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.OnlineStatusText, Mode=OneWay}" />
                        <TextBlock
                            Opacity="0.66"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.MembersSummaryText, Mode=OneWay}" />
                        <TextBlock
                            Opacity="0.66"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.PinnedSummaryText, Mode=OneWay}" />
                        <TextBlock
                            Opacity="0.66"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.RealtimeModeText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                    <Button
                        Command="{x:Bind ViewModel.CycleNotifyCommand}"
                        ToolTipService.ToolTip="切换通知模式">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xEA8F;" />
                            <TextBlock Text="{x:Bind ViewModel.NotifyModeText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.ToggleMembersPanelCommand}"
                        Style="{StaticResource ChatHeaderIconButtonStyle}"
                        ToolTipService.ToolTip="成员">
                        <FontIcon Glyph="&#xE716;" />
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.ToggleCallPanelCommand}"
                        Style="{StaticResource ChatHeaderIconButtonStyle}"
                        ToolTipService.ToolTip="语音和视频通话">
                        <FontIcon Glyph="&#xE717;" />
                    </Button>
                    <Button
                        Click="EncryptionSettings_OnClick"
                        Style="{StaticResource ChatHeaderIconButtonStyle}"
                        ToolTipService.ToolTip="加密与解密">
                        <FontIcon Glyph="&#xE72E;" />
                    </Button>
                    <Button Style="{StaticResource ChatHeaderIconButtonStyle}" ToolTipService.ToolTip="更多">
                        <FontIcon Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.LeaveRoomCommand}"
                                    Text="退出会话" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <ProgressRing
                        Width="22"
                        Height="22"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
          ListView keeps its internal ScrollViewer (do NOT wrap in an outer ScrollViewer)
          so item virtualization stays enabled for large group histories.
        -->
        <ListView
            x:Name="MessageList"
            Grid.Row="2"
            Padding="24,8,18,8"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageItemViewModel">
                    <Grid Margin="0,6" ColumnSpacing="8" HorizontalAlignment="{x:Bind Alignment}">
                        <Grid.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition
                                    FromHorizontalOffset="{x:Bind EntranceOffset}"
                                    FromVerticalOffset="8"
                                    IsStaggeringEnabled="False" />
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </Grid.Transitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar (tap → profile for others) -->
                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SenderAvatar_OnClick"
                            IsEnabled="{x:Bind CanOpenSenderProfile}"
                            Opacity="{x:Bind SenderNameOpacity}"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind SenderChromeVisibility}"
                            ToolTipService.ToolTip="查看主页">
                            <Grid Width="36" Height="36">
                                <Border
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                    CornerRadius="18">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Initials}" />
                                </Border>
                                <controls:FastWin2DImage
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    DecodeWidth="96"
                                    EnableFadeIn="True"
                                    ShowPlaceholder="False"
                                    Source="{x:Bind AvatarUrl}"
                                    Stretch="UniformToFill" />
                            </Grid>
                        </Button>

                        <Border
                            Grid.Column="1"
                            MaxWidth="520"
                            Padding="12,9"
                            Background="{x:Bind BubbleBackground}"
                            BorderBrush="{x:Bind BubbleStroke}"
                            BorderThickness="1"
                            CornerRadius="{x:Bind BubbleCornerRadius}"
                            Loaded="MessageBubble_OnLoaded"
                            Opacity="{x:Bind BubbleOpacity}"
                            Tag="{x:Bind}">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="ReplyMessage_OnClick"
                                        Text="回复"
                                        Tag="{x:Bind}" />
                                    <MenuFlyoutItem
                                        Click="ReactMessage_OnClick"
                                        Text="点赞"
                                        Tag="{x:Bind}" />
                                    <MenuFlyoutItem
                                        Click="PinMessage_OnClick"
                                        Text="置顶"
                                        Tag="{x:Bind}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Click="EditMessage_OnClick"
                                        Text="编辑"
                                        Tag="{x:Bind}" />
                                    <MenuFlyoutItem
                                        Click="DeleteMessage_OnClick"
                                        Text="删除"
                                        Tag="{x:Bind}" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Opacity="{x:Bind SenderNameOpacity}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind SenderName}"
                                    Visibility="{x:Bind SenderChromeVisibility}" />

                                <!-- Quoted reply -->
                                <Border
                                    Padding="8,6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="3,0,0,0"
                                    CornerRadius="6"
                                    Opacity="{x:Bind ReplyPreviewOpacity}">
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.85"
                                        Text="{x:Bind ReplyPreviewText}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWholeWords"
                                        MaxLines="2" />
                                </Border>

                                <!-- Forwarded chat message -->
                                <Border
                                    Padding="10,8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{x:Bind ForwardedPreviewVisibility}">
                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="转发的消息" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind ForwardedSenderName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="11"
                                                Opacity="0.55"
                                                Text="{x:Bind ForwardedTimeText}" />
                                        </Grid>
                                        <TextBlock
                                            FontSize="13"
                                            IsTextSelectionEnabled="True"
                                            MaxLines="10"
                                            Text="{x:Bind ForwardedContent}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>

                                <!-- Text + fenced code cards (stickers stripped when rendered as images) -->
                                <ItemsControl
                                    ItemsSource="{x:Bind ContentBlocks}"
                                    Opacity="{x:Bind TextOpacity}"
                                    HorizontalContentAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MessageContentBlockViewModel">
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind Content}"
                                                    TextWrapping="WrapWholeWords"
                                                    Visibility="{x:Bind TextVisibility}" />
                                                <controls:CodeSnippetCard
                                                    Code="{x:Bind Content}"
                                                    CodeLanguage="{x:Bind Language}"
                                                    Visibility="{x:Bind CodeVisibility}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <controls:LinkPreviewCard
                                    Url="{x:Bind LinkPreviewUrl, Mode=OneWay}"
                                    Visibility="{x:Bind LinkPreviewVisibility, Mode=OneWay}" />

                                <!-- Stickers (:prefix+slug: → image) -->
                                <ItemsControl
                                    ItemsSource="{x:Bind Stickers}"
                                    Opacity="{x:Bind StickersOpacity, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MessageStickerViewModel">
                                            <Grid
                                                Width="{x:Bind MaxSide}"
                                                Height="{x:Bind MaxSide}"
                                                Margin="0,2">
                                                <Border
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    CornerRadius="8">
                                                    <Grid>
                                                        <ProgressRing
                                                            x:Name="StickerRing"
                                                            Width="24"
                                                            Height="24"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            IsActive="{Binding IsLoading, ElementName=StickerImg, Mode=OneWay}" />
                                                        <controls:FastWin2DImage
                                                            x:Name="StickerImg"
                                                            DecodeWidth="256"
                                                            EnableFadeIn="True"
                                                            ShowPlaceholder="False"
                                                            Source="{x:Bind FileId, Mode=OneWay}"
                                                            Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Attachments / images (DysonFS) -->
                                <ItemsControl
                                    ItemsSource="{x:Bind Attachments}"
                                    Opacity="{x:Bind AttachmentsOpacity}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MessageAttachmentViewModel">
                                            <StackPanel Margin="0,2" Spacing="4">
                                                <Grid MaxWidth="280" Visibility="{x:Bind ImageAreaVisibility}">
                                                    <Border
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                        CornerRadius="8"
                                                        MinHeight="80"
                                                        Tag="{x:Bind}"
                                                        Tapped="AttachmentImage_OnTapped">
                                                        <Grid>
                                                            <ProgressRing
                                                                Width="28"
                                                                Height="28"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                IsActive="{Binding IsLoading, ElementName=AttImg, Mode=OneWay}" />
                                                            <controls:FastWin2DImage
                                                                x:Name="AttImg"
                                                                MaxHeight="240"
                                                                CornerRadius="8"
                                                                DecodeWidth="640"
                                                                EnableFadeIn="True"
                                                                ShowPlaceholder="True"
                                                                Source="{x:Bind ImageSourceKey}"
                                                                Stretch="Uniform" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                <Border
                                                    MaxWidth="320"
                                                    MinWidth="220"
                                                    Height="180"
                                                    Background="#22000000"
                                                    CornerRadius="8"
                                                    Loaded="AttachmentVideo_OnLoaded"
                                                    Tag="{x:Bind}"
                                                    Tapped="AttachmentVideo_OnTapped"
                                                    Visibility="{x:Bind VideoAreaVisibility}">
                                                    <Grid>
                                                        <controls:FastWin2DImage
                                                            CornerRadius="8"
                                                            DecodeWidth="640"
                                                            EnableFadeIn="True"
                                                            ShowPlaceholder="False"
                                                            Source="{x:Bind VideoThumbnailPath, Mode=OneWay}"
                                                            Stretch="UniformToFill" />
                                                        <Border
                                                            Width="52"
                                                            Height="52"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="#AA000000"
                                                            CornerRadius="26">
                                                            <FontIcon
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="24"
                                                                Foreground="White"
                                                                Glyph="&#xE768;" />
                                                        </Border>
                                                        <Border
                                                            Padding="8,4"
                                                            VerticalAlignment="Bottom"
                                                            Background="#99000000"
                                                            CornerRadius="0,0,8,8">
                                                            <TextBlock
                                                                Foreground="White"
                                                                Text="{x:Bind Name}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Border
                                                    Padding="8,4"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="6"
                                                    Visibility="{x:Bind FileChipVisibility}">
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock
                                    Opacity="0.75"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ReactionText, Mode=OneWay}"
                                    Visibility="{x:Bind ReactionVisibility, Mode=OneWay}" />

                                <Grid HorizontalAlignment="{x:Bind FooterAlignment}" ColumnSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Opacity="0.52"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind TimeText}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind MineChromeVisibility}">
                                        <ProgressRing Width="11" Height="11" IsActive="{x:Bind IsPending}" Visibility="{x:Bind PendingVisibility}" />
                                        <FontIcon FontSize="10" Glyph="&#xE73E;" Opacity="0.64" Visibility="{x:Bind SentVisibility}" />
                                        <TextBlock Opacity="0.58" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind DeliveryStatusText}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Compact action tray; all actions also remain available from the context menu. -->
                                <Border
                                    Margin="0,2,0,0"
                                    Padding="3"
                                    HorizontalAlignment="{x:Bind FooterAlignment}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Opacity="0.9">
                                    <StackPanel Orientation="Horizontal" Spacing="1">
                                        <Button
                                            Click="ReplyMessage_OnClick"
                                            Style="{StaticResource MessageActionButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="回复此消息">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontSize="12" Glyph="&#xE97A;" />
                                                <TextBlock VerticalAlignment="Center" Text="回复" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Click="ReactMessage_OnClick"
                                            Style="{StaticResource MessageActionButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="点赞此消息">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontSize="12" Glyph="&#xE8E1;" />
                                                <TextBlock VerticalAlignment="Center" Text="点赞" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Click="PinMessage_OnClick"
                                            Style="{StaticResource MessageActionButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="置顶此消息">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontSize="12" Glyph="&#xE718;" />
                                                <TextBlock VerticalAlignment="Center" Text="置顶" />
                                            </StackPanel>
                                        </Button>
                                        <Rectangle
                                            Width="1"
                                            Height="16"
                                            Margin="3,0"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            Visibility="{x:Bind MineChromeVisibility}" />
                                        <Button
                                            Click="EditMessage_OnClick"
                                            Style="{StaticResource MessageActionButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="编辑"
                                            Visibility="{x:Bind MineChromeVisibility}">
                                            <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                        </Button>
                                        <Button
                                            Click="DeleteMessage_OnClick"
                                            Style="{StaticResource MessageActionButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="删除"
                                            Visibility="{x:Bind MineChromeVisibility}">
                                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Sticker picker panel -->
        <Border
            Grid.Row="2"
            Grid.Column="1"
            Width="300"
            Margin="0,0,8,0"
            Padding="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{x:Bind ViewModel.StickerPanelVisibility, Mode=OneWay}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock FontWeight="SemiBold" Text="贴纸 / 表情包" />
                    <Button
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.ToggleStickerPanelCommand}"
                        Content="关闭"
                        FontSize="12"
                        Padding="8,2" />
                </Grid>
                <ComboBox
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.StickerPacks, Mode=OneWay}"
                    SelectedIndex="{x:Bind ViewModel.SelectedStickerPackIndex, Mode=TwoWay}"
                    DisplayMemberPath="Title"
                    PlaceholderText="选择贴纸包…" />
                <GridView
                    Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.StickerGrid, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="StickerGrid_OnItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:StickerPickItem">
                            <Border
                                Width="72"
                                Height="72"
                                Margin="4"
                                CornerRadius="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <controls:FastWin2DImage
                                        DecodeWidth="256"
                                        EnableFadeIn="False"
                                        ShowPlaceholder="True"
                                        Source="{x:Bind ImageFileId}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        VerticalAlignment="Bottom"
                                        FontSize="9"
                                        Opacity="0.7"
                                        Text="{x:Bind Title}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <TextBlock
                    Grid.Row="3"
                    Opacity="0.65"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.StickerPanelStatus, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Side panels -->
        <Border
            Grid.Row="2"
            Grid.Column="1"
            Width="300"
            Margin="0,0,8,0"
            Padding="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{x:Bind ViewModel.MembersPanelVisibility, Mode=OneWay}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="成员管理" />
                <StackPanel Grid.Row="1" Spacing="6">
                    <TextBox
                        PlaceholderText="本群昵称"
                        Text="{x:Bind ViewModel.MyRoomNick, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.SaveMyRoomNickCommand}"
                        Content="保存昵称" />
                    <TextBox
                        PlaceholderText="禁言分钟数"
                        Text="{x:Bind ViewModel.TimeoutMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.RefreshMembersCommand}"
                        Content="刷新成员" />
                </StackPanel>
                <ListView
                    Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.Members, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMemberItemViewModel">
                            <StackPanel Padding="2,6" Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                <TextBlock
                                    Opacity="0.6"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind TimeoutText}" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button
                                        Click="KickMember_OnClick"
                                        Content="踢出"
                                        FontSize="11"
                                        Padding="8,2"
                                        Tag="{x:Bind}" />
                                    <Button
                                        Click="TimeoutMember_OnClick"
                                        Content="禁言"
                                        FontSize="11"
                                        Padding="8,2"
                                        Tag="{x:Bind}" />
                                    <Button
                                        Click="ClearTimeout_OnClick"
                                        Content="解禁"
                                        FontSize="11"
                                        Padding="8,2"
                                        Tag="{x:Bind}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Grid.Column="1"
            Width="300"
            Margin="0,0,8,0"
            Padding="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{x:Bind ViewModel.CallPanelVisibility, Mode=OneWay}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="实时通话（语音 / 视频）" />
                <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock Text="{x:Bind ViewModel.CallStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            Opacity="0.75"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ConnectionQualityText, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="弱网重连中…"
                            Visibility="{x:Bind ViewModel.ReconnectingBannerVisibility, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.CallEndpointText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />

                    <!-- Focus surface -->
                    <Border
                        Height="140"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.4"
                                Text="焦点画面（点下方宫格切换）" />
                            <Image
                                Stretch="Uniform"
                                Source="{x:Bind ViewModel.RemoteVideoBitmap, Mode=OneWay}" />
                            <Border
                                Width="72"
                                Height="54"
                                Margin="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Image
                                    Stretch="UniformToFill"
                                    Source="{x:Bind ViewModel.LocalVideoBitmap, Mode=OneWay}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Multi video grid -->
                    <GridView
                        Height="120"
                        ItemsSource="{x:Bind ViewModel.VideoTiles, Mode=OneWay}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="VideoTile_OnItemClick">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="svc:CallVideoTile">
                                <Border
                                    Width="96"
                                    Height="72"
                                    Margin="2"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid>
                                        <Image Stretch="UniformToFill" Source="{x:Bind Bitmap, Mode=OneWay}" />
                                        <StackPanel VerticalAlignment="Bottom" Background="#88000000" Padding="4,2">
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="White"
                                                Text="{x:Bind DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="9"
                                                Foreground="#CCFFFFFF"
                                                Text="{x:Bind QualityText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.JoinVoiceCommand}"
                        Content="加入通话"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.JoinCallVisibility, Mode=OneWay}" />

                    <StackPanel
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.InCallControlsVisibility, Mode=OneWay}">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.ToggleMicCommand}"
                                Content="{x:Bind ViewModel.MicToggleLabel, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.ToggleCameraCommand}"
                                Content="{x:Bind ViewModel.CameraToggleLabel, Mode=OneWay}" />
                        </Grid>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.ToggleScreenShareCommand}"
                                Content="{x:Bind ViewModel.ScreenShareToggleLabel, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.ToggleSidetoneCommand}"
                                Content="{x:Bind ViewModel.SidetoneToggleLabel, Mode=OneWay}" />
                        </Grid>
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.HangUpCommand}"
                            Content="挂断" />

                        <TextBlock FontSize="12" Opacity="0.7" Text="设备" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            Header="麦克风"
                            ItemsSource="{x:Bind ViewModel.MicDeviceNames, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedMicDeviceIndex, Mode=TwoWay}"
                            SelectionChanged="MicDevice_OnSelectionChanged" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            Header="扬声器"
                            ItemsSource="{x:Bind ViewModel.SpeakerDeviceNames, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedSpeakerDeviceIndex, Mode=TwoWay}"
                            SelectionChanged="SpeakerDevice_OnSelectionChanged" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            Header="摄像头"
                            ItemsSource="{x:Bind ViewModel.CameraDeviceNames, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedCameraDeviceIndex, Mode=TwoWay}"
                            SelectionChanged="CameraDevice_OnSelectionChanged" />
                    </StackPanel>

                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.RefreshCallCommand}"
                        Content="刷新参与者" />
                    <TextBox
                        PlaceholderText="邀请账号 UUID"
                        Text="{x:Bind ViewModel.InviteAccountIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.InviteToCallCommand}"
                        Content="邀请入会" />
                </StackPanel>
                <ProgressRing
                    Grid.Row="2"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsCallConnecting, Mode=OneWay}" />
                <ListView
                    Grid.Row="3"
                    MaxHeight="160"
                    ItemsSource="{x:Bind ViewModel.CallParticipants, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CallParticipantItemViewModel">
                            <StackPanel Padding="2,6" Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button
                                        Click="MuteCall_OnClick"
                                        Content="静音"
                                        FontSize="11"
                                        Padding="8,2"
                                        Tag="{x:Bind}" />
                                    <Button
                                        Click="UnmuteCall_OnClick"
                                        Content="开麦"
                                        FontSize="11"
                                        Padding="8,2"
                                        Tag="{x:Bind}" />
                                    <Button
                                        Click="KickCall_OnClick"
                                        Content="踢出"
                                        FontSize="11"
                                        Padding="8,2"
                                        Tag="{x:Bind}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Padding="12,0" Spacing="4">
            <ProgressRing
                Width="24"
                Height="24"
                HorizontalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextWrapping="Wrap" />

            <!-- Bot commands panel -->
            <Border
                MaxHeight="220"
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{x:Bind ViewModel.BotPanelVisibility, Mode=OneWay}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="机器人命令"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.ToggleBotPanelCommand}"
                            Content="关闭"
                            Padding="10,4" />
                    </Grid>
                    <ListView
                        Grid.Row="1"
                        MaxHeight="160"
                        IsItemClickEnabled="True"
                        ItemClick="BotCommand_OnItemClick"
                        ItemsSource="{x:Bind ViewModel.BotCommands, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatBotCommandItem">
                                <Grid Padding="4,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Padding="8,4"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="6">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="{x:Bind Title}" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Opacity="0.75"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Subtitle}"
                                        TextWrapping="WrapWholeWords" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Grid.Row="2"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.BotPanelStatusText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </Grid>
            </Border>

            <!-- Autocomplete / bot / mention suggestions -->
            <Border
                MaxHeight="200"
                Padding="6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{x:Bind ViewModel.SuggestionsVisibility, Mode=OneWay}">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.SuggestionHintText, Mode=OneWay}" />
                    <ListView
                        x:Name="SuggestionList"
                        Grid.Row="1"
                        MaxHeight="168"
                        IsItemClickEnabled="True"
                        ItemClick="Suggestion_OnItemClick"
                        ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatSuggestionItem">
                                <Grid Padding="2,2">
                                    <Border
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Opacity="0.4"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                    <Grid Padding="6,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            FontSize="14"
                                            Glyph="{x:Bind Glyph}"
                                            Opacity="0.85" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4">
                                            <TextBlock FontSize="11" Text="{x:Bind KindLabel}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="1">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock
                                                Opacity="0.65"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Subtitle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Opacity="{x:Bind ViewModel.PendingImagePanelOpacity, Mode=OneWay}">
                <FontIcon Glyph="&#xE723;" />
                <TextBlock
                    VerticalAlignment="Center"
                    Opacity="0.85"
                    Text="{x:Bind ViewModel.PendingImageName, Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.ClearPendingImageCommand}"
                    Content="清除" />
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.RecordingVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE720;" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.RecordingElapsedText, Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.CancelVoiceRecordCommand}"
                    Content="取消录音" />
            </StackPanel>

            <ProgressBar
                Maximum="1"
                Minimum="0"
                Value="{x:Bind ViewModel.UploadProgress, Mode=OneWay}" />
            <ProgressRing
                Width="22"
                Height="22"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsSendingVoice, Mode=OneWay}" />
        </StackPanel>

        <Border
            Grid.Row="4"
            Grid.ColumnSpan="2"
            Margin="12,4,12,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel Spacing="0">
            <!-- Reply banner -->
            <Grid
                Padding="12,8,12,4"
                ColumnSpacing="8"
                Visibility="{x:Bind ViewModel.ReplyTargetVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Padding="10,6"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="3,0,0,0"
                    CornerRadius="8">
                    <TextBlock
                        FontSize="13"
                        Text="{x:Bind ViewModel.ReplyBannerText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Border>
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.CancelReplyCommand}"
                    Content="取消"
                    FontSize="12"
                    Padding="10,4" />
            </Grid>

            <Grid Padding="9" ColumnSpacing="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Click="PickImage_OnClick"
                    IsEnabled="{x:Bind ViewModel.IsComposerEnabled, Mode=OneWay}"
                    Style="{StaticResource ComposerIconButtonStyle}"
                    ToolTipService.ToolTip="发送图片或视频">
                    <FontIcon Glyph="&#xE723;" />
                </Button>
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.ToggleStickerPanelCommand}"
                    IsEnabled="{x:Bind ViewModel.IsComposerEnabled, Mode=OneWay}"
                    Style="{StaticResource ComposerIconButtonStyle}"
                    ToolTipService.ToolTip="表情包 / 贴图">
                    <FontIcon Glyph="&#xE76E;" />
                </Button>
                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.ToggleVoiceRecordCommand}"
                    Content="{x:Bind ViewModel.RecordButtonText, Mode=OneWay}"
                    CornerRadius="12" />
                <Button
                    Grid.Column="3"
                    Command="{x:Bind ViewModel.ToggleBotPanelCommand}"
                    IsEnabled="{x:Bind ViewModel.IsComposerEnabled, Mode=OneWay}"
                    Style="{StaticResource ComposerIconButtonStyle}"
                    ToolTipService.ToolTip="机器人命令面板（也可用 / 触发）">
                    <FontIcon Glyph="&#xE943;" />
                </Button>
                <TextBox
                    x:Name="DraftBox"
                    Grid.Column="4"
                    AcceptsReturn="False"
                    IsEnabled="{x:Bind ViewModel.IsComposerEnabled, Mode=OneWay}"
                    KeyDown="DraftBox_OnKeyDown"
                    CornerRadius="12"
                    PlaceholderText="输入消息…  使用 / 命令，@ 提及成员"
                    Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="5"
                    MinWidth="88"
                    Command="{x:Bind ViewModel.SendCommand}"
                    Content="发送"
                    CornerRadius="12"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
