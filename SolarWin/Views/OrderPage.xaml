<?xml version="1.0" encoding="utf-8"?>
<Page x:Name="RootPage"
    x:Class="SolarWin.Views.OrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SolarWin.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="28,22" Background="#FF0B3B86" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Foreground="White" FontSize="28" FontWeight="SemiBold" Text="瑞幸咖啡" />
                <TextBlock Foreground="#DDE8F7FF" Text="选门店、挑咖啡，预览确认后创建真实自提订单" />
            </StackPanel>
            <ProgressRing Grid.Column="1" Width="28" Height="28" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="1" Padding="28,22" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="480"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="连接与门店" />
                            <PasswordBox x:Name="TokenBox" Header="MCP 密钥" PlaceholderText="Bearer 后面的密钥" PasswordChanged="TokenBox_OnPasswordChanged" />
                            <Button HorizontalAlignment="Left" Content="安全保存密钥" Command="{x:Bind ViewModel.SaveTokenCommand}" />
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Header="所在城市" Text="{x:Bind ViewModel.LocationText, Mode=TwoWay}" PlaceholderText="例如：北京、杭州；留空自动定位" />
                                <TextBox Grid.Column="1" Header="门店名称（可选）" Text="{x:Bind ViewModel.ShopKeyword, Mode=TwoWay}" PlaceholderText="例如：南京西路" />
                                <Button Grid.Column="2" VerticalAlignment="Bottom" Content="查找门店" Command="{x:Bind ViewModel.SearchShopsCommand}" />
                            </Grid>
                            <ComboBox Header="取餐门店" ItemsSource="{x:Bind ViewModel.Shops}" SelectedItem="{x:Bind ViewModel.SelectedShop, Mode=TwoWay}" DisplayMemberPath="DisplayText" PlaceholderText="请选择门店" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Header="想喝什么" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" PlaceholderText="留空全量扫描当前门店咖啡菜单，也可输入生椰拿铁等关键词" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Content="查找咖啡" Command="{x:Bind ViewModel.SearchProductsCommand}" />
                    </Grid>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Products}">
                        <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="220" MinColumnSpacing="12" MinRowSpacing="12" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrderProduct">
                                <Border Margin="0,0,0,12" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel Spacing="10">
                                        <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Tag="{x:Bind}" Click="ProductImage_OnClick" ToolTipService.ToolTip="点击选择杯型、冷热、糖度等规格">
                                            <Border Height="200" Padding="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6">
                                                <Image Source="{x:Bind PictureSource, Mode=OneTime}" Stretch="Uniform" />
                                            </Border>
                                        </Button>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                        <Grid><TextBlock VerticalAlignment="Center" Foreground="#FF0B60B7" FontSize="18" FontWeight="SemiBold" Text="{x:Bind PriceText, Mode=OneWay}"/><Button HorizontalAlignment="Right" Content="加入" Command="{Binding ElementName=RootPage, Path=ViewModel.AddToCartCommand}" CommandParameter="{x:Bind}" /></Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="5"><TextBlock FontSize="20" FontWeight="SemiBold" Text="购物车"/><TextBlock Opacity="0.7" Text="真实下单前必须先预览最终价格"/></StackPanel>
                    <ListView Grid.Row="1" Margin="0,14" ItemsSource="{x:Bind ViewModel.Cart}">
                        <ListView.ItemTemplate><DataTemplate x:DataType="vm:OrderProduct"><Grid Padding="0,8" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="{x:Bind Name}"/><TextBlock FontSize="12" Opacity="0.7" Text="{x:Bind AttrSummary}" Visibility="{x:Bind HasAttrSummary}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"><Button Content="−" Padding="10,2" Command="{Binding ElementName=RootPage, Path=ViewModel.DecreaseCartItemCommand}" CommandParameter="{x:Bind}"/><TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{x:Bind AmountText, Mode=OneWay}"/><Button Content="+" Padding="10,2" Command="{Binding ElementName=RootPage, Path=ViewModel.IncreaseCartItemCommand}" CommandParameter="{x:Bind}"/><Button Content="删除" Padding="10,2" Command="{Binding ElementName=RootPage, Path=ViewModel.RemoveFromCartCommand}" CommandParameter="{x:Bind}"/></StackPanel></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind PriceText, Mode=OneWay}"/></Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.CartTotalText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.PaymentSummary, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap"/>
                        <Button Content="预览最终价格" Command="{x:Bind ViewModel.PreviewCommand}"/>
                        <Button Style="{StaticResource AccentButtonStyle}" Content="确认并创建真实订单" Click="CreateOrder_OnClick"/>
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasOrderId, Mode=OneWay}">
                            <TextBox Header="订单号" Text="{x:Bind ViewModel.OrderId, Mode=TwoWay}" PlaceholderText="创建后自动填入；也可粘贴瑞幸订单号恢复查询" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button HorizontalAlignment="Stretch" Content="查询支付状态" Command="{x:Bind ViewModel.QueryOrderStatusCommand}" />
                                <Button Grid.Column="1" HorizontalAlignment="Stretch" Content="取消订单" Click="CancelOrder_OnClick" />
                            </Grid>
                        </StackPanel>
                        <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Visibility="{x:Bind ViewModel.PayVisibility, Mode=OneWay}">
                            <StackPanel HorizontalAlignment="Center" Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="微信扫码支付" />
                                <Image Width="230" Height="230" Source="{x:Bind ViewModel.PayImageSource, Mode=OneWay}" Stretch="Uniform" />
                                <Button HorizontalAlignment="Stretch" Content="在浏览器中打开支付二维码" Click="OpenPayment_OnClick" Visibility="{x:Bind ViewModel.CanOpenPayInBrowser, Mode=OneWay}" />
                                <TextBlock FontSize="12" Opacity="0.7" Text="支付完成后请点“查询支付状态”确认并查看取餐码" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
