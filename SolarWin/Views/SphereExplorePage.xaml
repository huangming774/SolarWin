<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SolarWin.Views.SphereExplorePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SolarWin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SolarWin.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="ExploreHeroBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#E8F3FF" />
                        <GradientStop Offset="0.52" Color="#F0ECFF" />
                        <GradientStop Offset="1" Color="#FFF0F5" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="ExploreSoftAccentBrush" Color="#E0EAFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="ExploreHeroBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#203249" />
                        <GradientStop Offset="0.52" Color="#302B48" />
                        <GradientStop Offset="1" Color="#432B3B" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="ExploreSoftAccentBrush" Color="#2A3A55" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <LinearGradientBrush x:Key="ExploreHeroBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#203249" />
                        <GradientStop Offset="0.52" Color="#302B48" />
                        <GradientStop Offset="1" Color="#432B3B" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="ExploreSoftAccentBrush" Color="#2A3A55" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="ExploreCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="18" />
            </Style>
            <Style x:Key="ExplorePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style TargetType="ListView">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="4" />
            </Style>
            <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Margin" Value="0,2" />
            </Style>
            <Style TargetType="GridViewItem">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Margin" Value="2" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid MaxWidth="1320" Padding="24,18,24,16" HorizontalAlignment="Stretch" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="20" Background="{ThemeResource ExploreHeroBrush}" CornerRadius="20">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" VerticalAlignment="Center" Background="{ThemeResource ExploreSoftAccentBrush}" CornerRadius="16">
                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23" Glyph="&#xE8B1;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock FontSize="25" FontWeight="SemiBold" Text="探索 Sphere" />
                    <TextBlock Opacity="0.68" Text="发现创作者、精选内容、标签与贴纸，让每次浏览都有新鲜感。" TextWrapping="Wrap" />
                    <TextBlock Opacity="0.52" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <Button Command="{x:Bind ViewModel.LoadCommand}" Content="刷新探索" Style="{StaticResource ExplorePrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="2">
            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Opacity="0.65" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.InfoMessage, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>

        <Pivot Grid.Row="2">
            <!-- Publishers -->
            <PivotItem Header="发布者">
                <ScrollViewer Padding="0,8,0,0">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="140" PlaceholderText="name" Text="{x:Bind ViewModel.NewPublisherName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Width="140" PlaceholderText="显示名" Text="{x:Bind ViewModel.NewPublisherNick, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{x:Bind ViewModel.CreatePublisherCommand}" Content="创建个人发布者" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="220" PlaceholderText="搜索发布者" Text="{x:Bind ViewModel.PublisherSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{x:Bind ViewModel.SearchPublishersCommand}" Content="搜索" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="我的发布者" />
                        <ListView MaxHeight="200" ItemsSource="{x:Bind ViewModel.MyPublishers, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock Opacity="0.7" Text="{x:Bind Subtitle}" />
                                            <TextBlock Opacity="0.5" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Meta}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="管理"
                                                Command="{Binding ElementName=RootPage, Path=ViewModel.OpenPublisherCommand}"
                                                CommandParameter="{x:Bind}"
                                                Style="{StaticResource AccentButtonStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="搜索结果" />
                        <ListView MaxHeight="180" ItemsSource="{x:Bind ViewModel.SearchPublishers, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock Opacity="0.7" Text="{x:Bind Subtitle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="打开"
                                                Command="{Binding ElementName=RootPage, Path=ViewModel.OpenPublisherCommand}"
                                                CommandParameter="{x:Bind}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="邀请" />
                        <ListView MaxHeight="140" ItemsSource="{x:Bind ViewModel.PublisherInvites, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Content="接受" Command="{Binding ElementName=RootPage, Path=ViewModel.AcceptPublisherInviteCommand}" CommandParameter="{x:Bind}" />
                                            <Button Content="拒绝" Command="{Binding ElementName=RootPage, Path=ViewModel.DeclinePublisherInviteCommand}" CommandParameter="{x:Bind}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Subscriptions -->
            <PivotItem Header="订阅">
                <ScrollViewer Padding="0,8,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="发布者订阅" />
                        <ListView MaxHeight="280" ItemsSource="{x:Bind ViewModel.PublisherSubscriptions, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock Opacity="0.7" Text="{x:Bind Subtitle}" />
                                            <TextBlock Opacity="0.5" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Meta}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Content="打开" Command="{Binding ElementName=RootPage, Path=ViewModel.OpenPublisherCommand}" CommandParameter="{x:Bind}" />
                                            <Button Content="退订" Command="{Binding ElementName=RootPage, Path=ViewModel.UnsubscribePublisherCommand}" CommandParameter="{x:Bind}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="帖子订阅" />
                        <ListView MaxHeight="200" ItemsSource="{x:Bind ViewModel.PostSubscriptions, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <StackPanel Padding="4,8">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                        <TextBlock Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Meta}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Bookmarks -->
            <PivotItem Header="书签">
                <ListView Padding="0,8,0,0" ItemsSource="{x:Bind ViewModel.Bookmarks, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Bookmark_OnItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PostItemViewModel">
                            <Grid Padding="4,10" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind AuthorName}" />
                                    <TextBlock Opacity="0.85" Text="{x:Bind ContentText}" TextWrapping="WrapWholeWords" MaxLines="3" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="取消书签"
                                        Command="{Binding ElementName=RootPage, Path=ViewModel.UnbookmarkPostCommand}"
                                        CommandParameter="{x:Bind}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <!-- Drafts / Featured -->
            <PivotItem Header="草稿/精选">
                <ScrollViewer Padding="0,8,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="草稿" />
                        <ListView MaxHeight="240" ItemsSource="{x:Bind ViewModel.Drafts, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Draft_OnItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PostItemViewModel">
                                    <StackPanel Padding="4,8" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind AuthorName}" />
                                        <TextBlock Opacity="0.85" Text="{x:Bind ContentText}" TextWrapping="Wrap" MaxLines="3" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="精选" />
                        <ListView MaxHeight="240" ItemsSource="{x:Bind ViewModel.Featured, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Featured_OnItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PostItemViewModel">
                                    <StackPanel Padding="4,8" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind AuthorName}" />
                                        <TextBlock Opacity="0.85" Text="{x:Bind ContentText}" TextWrapping="Wrap" MaxLines="3" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Tags / Categories / Collections -->
            <PivotItem Header="标签/分类">
                <ScrollViewer Padding="0,8,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="标签" />
                        <ListView MaxHeight="200" ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Meta}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Content="看帖" Command="{Binding ElementName=RootPage, Path=ViewModel.OpenTagFeedCommand}" CommandParameter="{x:Bind}" Style="{StaticResource AccentButtonStyle}" />
                                            <Button Content="订阅" Command="{Binding ElementName=RootPage, Path=ViewModel.SubscribeTagCommand}" CommandParameter="{x:Bind}" />
                                            <Button Content="退订" Command="{Binding ElementName=RootPage, Path=ViewModel.UnsubscribeTagCommand}" CommandParameter="{x:Bind}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="分类" />
                        <ListView MaxHeight="180" ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Content="看帖" Command="{Binding ElementName=RootPage, Path=ViewModel.OpenCategoryFeedCommand}" CommandParameter="{x:Bind}" Style="{StaticResource AccentButtonStyle}" />
                                            <Button Content="订阅" Command="{Binding ElementName=RootPage, Path=ViewModel.SubscribeCategoryCommand}" CommandParameter="{x:Bind}" />
                                            <Button Content="退订" Command="{Binding ElementName=RootPage, Path=ViewModel.UnsubscribeCategoryCommand}" CommandParameter="{x:Bind}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="合集" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="200" PlaceholderText="发布者 name" Text="{x:Bind ViewModel.CollectionPublisherName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{x:Bind ViewModel.LoadCollectionsCommand}" Content="加载合集" />
                        </StackPanel>
                        <ListView MaxHeight="180" ItemsSource="{x:Bind ViewModel.Collections, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <Grid Padding="4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                            <TextBlock Opacity="0.7" Text="{x:Bind Meta}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Content="看帖"
                                                    Command="{Binding ElementName=RootPage, Path=ViewModel.OpenCollectionFeedCommand}"
                                                    CommandParameter="{x:Bind}"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                            <Button Content="订阅合集"
                                                    Command="{Binding ElementName=RootPage, Path=ViewModel.SubscribeCollectionCommand}"
                                                    CommandParameter="{x:Bind}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Stickers -->
            <PivotItem Header="贴纸">
                <ScrollViewer Padding="0,8,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Opacity="0.75"
                            Text="点选贴纸包可加载内容图片；封面与贴纸经 DysonFS 鉴权加载。"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="我的贴纸包" />
                        <GridView
                            MaxHeight="200"
                            IsItemClickEnabled="True"
                            ItemClick="MyStickerPack_OnItemClick"
                            ItemsSource="{x:Bind ViewModel.StickerPacks, Mode=OneWay}"
                            SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:StickerPackItemViewModel">
                                    <Border
                                        Width="100"
                                        Margin="4"
                                        Padding="6"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <StackPanel Spacing="4">
                                            <Grid Height="72" Width="88">
                                                <Border
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="8" />
                                                <ProgressRing
                                                    Width="24"
                                                    Height="24"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsActive="{Binding IsLoading, ElementName=PackIconImg, Mode=OneWay}" />
                                                <controls:FastWin2DImage
                                                    x:Name="PackIconImg"
                                                    Height="72"
                                                    CornerRadius="8"
                                                    DecodeWidth="256"
                                                    EnableFadeIn="True"
                                                    ShowPlaceholder="False"
                                                    Source="{x:Bind IconFileId}"
                                                    Stretch="Uniform" />
                                            </Grid>
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="2"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                FontSize="11"
                                                Opacity="0.65"
                                                Text="{x:Bind Subtitle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                Width="220"
                                PlaceholderText="搜索贴纸包 / 贴纸"
                                Text="{x:Bind ViewModel.StickerSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{x:Bind ViewModel.SearchStickersCommand}" Content="搜索" />
                        </StackPanel>
                        <TextBlock
                            FontSize="12"
                            Opacity="0.7"
                            Text="匹配的贴纸包（点选查看内容 / 添加）" />
                        <GridView
                            MaxHeight="220"
                            IsItemClickEnabled="True"
                            ItemClick="SearchStickerPack_OnItemClick"
                            ItemsSource="{x:Bind ViewModel.StickerSearch, Mode=OneWay}"
                            SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:StickerPackItemViewModel">
                                    <Border
                                        Width="120"
                                        Margin="4"
                                        Padding="6"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <StackPanel Spacing="4">
                                            <Grid Height="72">
                                                <Border
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="8" />
                                                <ProgressRing
                                                    Width="24"
                                                    Height="24"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsActive="{Binding IsLoading, ElementName=SearchPackIconImg, Mode=OneWay}" />
                                                <controls:FastWin2DImage
                                                    x:Name="SearchPackIconImg"
                                                    Height="72"
                                                    CornerRadius="8"
                                                    DecodeWidth="256"
                                                    EnableFadeIn="True"
                                                    ShowPlaceholder="False"
                                                    Source="{x:Bind IconFileId}"
                                                    Stretch="Uniform" />
                                            </Grid>
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="2" />
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                Click="OwnSticker_OnClick"
                                                Content="添加"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Tag="{x:Bind}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <TextBlock
                            FontSize="12"
                            Opacity="0.7"
                            Text="匹配的贴纸图片（点选打开所属贴纸包）" />
                        <GridView
                            MaxHeight="240"
                            IsItemClickEnabled="True"
                            ItemClick="SearchStickerHit_OnItemClick"
                            ItemsSource="{x:Bind ViewModel.StickerSearchHits, Mode=OneWay}"
                            SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:StickerItemViewModel">
                                    <Border
                                        Width="88"
                                        Margin="4"
                                        Padding="4"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel Spacing="2">
                                            <Grid Height="72" Width="80">
                                                <Border
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="6" />
                                                <ProgressRing
                                                    Width="22"
                                                    Height="22"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsActive="{Binding IsLoading, ElementName=HitStickerImg, Mode=OneWay}" />
                                                <controls:FastWin2DImage
                                                    x:Name="HitStickerImg"
                                                    Height="72"
                                                    CornerRadius="6"
                                                    DecodeWidth="256"
                                                    EnableFadeIn="True"
                                                    ShowPlaceholder="False"
                                                    Source="{x:Bind ImageFileId}"
                                                    Stretch="Uniform" />
                                            </Grid>
                                            <TextBlock
                                                FontSize="11"
                                                Text="{x:Bind Title}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- Open pack stickers grid -->
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.OpenPackVisibility, Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.OpenPackTitle, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                                <Button
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.CloseOpenPackCommand}"
                                    Content="关闭" />
                            </Grid>
                            <GridView
                                MaxHeight="360"
                                ItemsSource="{x:Bind ViewModel.OpenPackStickers, Mode=OneWay}"
                                SelectionMode="None">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StickerItemViewModel">
                                        <Border
                                            Width="88"
                                            Margin="4"
                                            Padding="4"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel Spacing="2">
                                                <Grid Height="72" Width="80">
                                                    <Border
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="6" />
                                                    <ProgressRing
                                                        Width="22"
                                                        Height="22"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsActive="{Binding IsLoading, ElementName=OpenPackStickerImg, Mode=OneWay}" />
                                                    <controls:FastWin2DImage
                                                        x:Name="OpenPackStickerImg"
                                                        Height="72"
                                                        CornerRadius="6"
                                                        DecodeWidth="256"
                                                        EnableFadeIn="True"
                                                        ShowPlaceholder="False"
                                                        Source="{x:Bind ImageFileId}"
                                                        Stretch="Uniform" />
                                                </Grid>
                                                <TextBlock
                                                    FontSize="11"
                                                    Text="{x:Bind Title}"
                                                    TextAlignment="Center"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Awards / Sponsor -->
            <PivotItem Header="打赏/赞助">
                <ScrollViewer Padding="0,8,0,0">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Center" Spacing="16">
                        <Border Padding="22" Background="{ThemeResource ExploreHeroBrush}" CornerRadius="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" Background="{ThemeResource ExploreSoftAccentBrush}" CornerRadius="15">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Glyph="&#xE8F1;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="支持你喜欢的创作者" />
                                    <TextBlock Opacity="0.65" Text="从精选内容直接选择帖子，打赏表达心意，赞助提供长期支持。" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ExploreCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="选择目标帖子" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Title"
                                    Header="精选帖子"
                                    ItemsSource="{x:Bind ViewModel.Featured, Mode=OneWay}"
                                    PlaceholderText="选择一篇精选帖子"
                                    SelectedItem="{x:Bind ViewModel.SelectedAwardPost, Mode=TwoWay}" />
                                <TextBox
                                    Header="帖子 ID"
                                    PlaceholderText="也可以粘贴帖子 GUID"
                                    Text="{x:Bind ViewModel.AwardPostIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Opacity="0.65" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.MonetizeStatus, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ExploreCardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon FontSize="18" Glyph="&#xE8E1;" />
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="打赏" />
                                    </StackPanel>
                                    <TextBlock Opacity="0.62" Text="一次性表达喜欢，可附上一句留言。" TextWrapping="Wrap" />
                                    <TextBox Header="金额" PlaceholderText="例如 1" Text="{x:Bind ViewModel.AwardAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="留言（可选）" PlaceholderText="写下想对创作者说的话" Text="{x:Bind ViewModel.AwardMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.AwardPostCommand}" Content="确认打赏" Style="{StaticResource ExplorePrimaryButtonStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource ExploreCardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon FontSize="18" Glyph="&#xE8D7;" />
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="赞助" />
                                    </StackPanel>
                                    <TextBlock Opacity="0.62" Text="为优质内容提供更多支持。提交后会生成赞助订单。" TextWrapping="Wrap" />
                                    <TextBox Header="金额" PlaceholderText="例如 5" Text="{x:Bind ViewModel.SponsorAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.SponsorPostCommand}" Content="确认赞助" Style="{StaticResource ExplorePrimaryButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="近期打赏" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.LoadAwardsCommand}" Content="刷新记录" />
                        </Grid>
                        <ListView MaxHeight="320" ItemsSource="{x:Bind ViewModel.Awards, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SocialListItemViewModel">
                                    <StackPanel Padding="4,8">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                        <TextBlock Opacity="0.75" Text="{x:Bind Subtitle}" />
                                        <TextBlock Opacity="0.5" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Meta}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
