<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SolarWin.Controls.CodeSnippetCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="260">
    <Border
        Background="#FF151A23"
        BorderBrush="#FF303846"
        BorderThickness="1"
        CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Padding="12,0,6,0"
                Background="#FF1C222D"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Ellipse Width="9" Height="9" Fill="#FFFF5F57" />
                    <Ellipse Width="9" Height="9" Fill="#FFFFBD2E" />
                    <Ellipse Width="9" Height="9" Fill="#FF28C840" />
                </StackPanel>
                <TextBlock
                    x:Name="LanguageLabel"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="#FF9DA7B5"
                    FontFamily="Consolas"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="CODE" />
                <Button
                    x:Name="CopyButton"
                    Grid.Column="2"
                    MinWidth="44"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Click="CopyButton_OnClick"
                    Content="复制"
                    Foreground="#FFC8D0DC"
                    FontSize="11"
                    ToolTipService.ToolTip="复制代码" />
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                MaxHeight="380"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                ZoomMode="Disabled">
                <RichTextBlock
                    x:Name="CodeText"
                    Padding="14,12,18,14"
                    FontFamily="Consolas"
                    FontSize="13"
                    IsTextSelectionEnabled="True"
                    LineHeight="20"
                    TextWrapping="NoWrap" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
