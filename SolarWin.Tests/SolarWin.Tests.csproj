    <Compile Include="..\SolarWin\Helpers\AppPaths.cs" Link="Helpers\AppPaths.cs" />
    <Compile Include="..\SolarWin\Data\ChatMessageMapper.cs" Link="Data\ChatMessageMapper.cs" />
